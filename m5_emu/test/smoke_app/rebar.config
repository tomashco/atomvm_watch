{erl_opts, [debug_info]}.
{deps, []}.
{plugins, [{atomvm_rebar3_plugin, "0.7.5"}]}.
%% priv/ and include/ are empty on purpose (.gitkeep). rebar3 links them from
%% _build/default/lib/smoke_app/, and `rebar3 eunit` in m5_emu copies test/ with dereferencing
%% (cp -RpL), which fails on dangling links.
