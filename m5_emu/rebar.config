{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.
{plugins, [{atomvm_rebar3_plugin, "0.7.5"}]}.
{eunit_opts, [verbose]}.
%% test/smoke_app/ is a separate rebar3 project run under AtomVM (test/node/smoke.mjs). Only the
%% top level of test/ is compiled here (recursive => false), and the test list is explicit because
%% rebar3's default discovery walks test/ recursively and would ask for smoke_app and the
%% smoke app's plugin sources as test modules. {application, m5_emu} runs each <mod>_tests;
%% list here the test modules that have no matching src module.
{eunit_tests, [{application, m5_emu}, {module, m5_emu_api_tests}, {module, m5_peripherals_tests}]}.
{profiles, [{test, [{erl_opts, [debug_info, nowarn_export_all]},
                    {extra_src_dirs, [{"test", [{recursive, false}]}, "test/support"]}]}]}.
